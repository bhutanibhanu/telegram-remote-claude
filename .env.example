# --- Required ---------------------------------------------------------------
# Bot token from @BotFather (Telegram): /newbot -> copy the token.
TELEGRAM_BOT_TOKEN=123456789:AA-replace-with-your-bot-token

# Your numeric Telegram chat id(s), comma-separated. ONLY these can use the bot.
# Get yours by messaging @userinfobot on Telegram.
TELEGRAM_ALLOWED_CHAT_IDS=123456789

# --- Optional ---------------------------------------------------------------
# Directory Claude runs in by default (per-chat overridable with /cd). Default: home dir.
CLAUDE_WORKDIR=/Users/ray/dev

# Path to the claude binary if not on PATH.
CLAUDE_BIN=claude

# Force a specific model (default: Claude Code's own default).
# CLAUDE_MODEL=claude-opus-4-8

# Max seconds to wait for one Claude turn before timing out. Default 600.
CLAUDE_TIMEOUT_SECONDS=600

# Bypass Claude's permission prompts so it runs without asking. Default true.
# (Required for unattended remote use; see the security note in README.)
CLAUDE_SKIP_PERMISSIONS=true

# Persist per-chat session id + working dir across bot restarts. Optional.
CLAUDE_STATE_FILE=.claude_tg_sessions.json
