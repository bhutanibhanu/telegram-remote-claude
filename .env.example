# Claude Telegram Bot — configuration template.
# Copy to .env (`cp .env.example .env`) and fill in the two REQUIRED values.
# Everything under "Optional" is shown COMMENTED OUT at its built-in default — uncomment
# only the ones you want to change. Every variable here is read by claude_tg/config.py
# (Config.from_env); the defaults below match that code. NEVER commit your real .env.

# --- Required ---------------------------------------------------------------
# Bot token from @BotFather (Telegram): /newbot -> copy the token. Keep it secret.
TELEGRAM_BOT_TOKEN=123456789:AA-replace-with-your-bot-token

# Your numeric Telegram chat id(s), comma-separated. ONLY these chats can use the bot;
# everyone else is ignored. Get yours by messaging @userinfobot on Telegram.
TELEGRAM_ALLOWED_CHAT_IDS=123456789

# --- Optional (defaults shown; uncomment to override) -----------------------
# Directory Claude starts in by default (per-chat overridable with /cd). Default: your home dir.
# CLAUDE_WORKDIR=/Users/you/dev

# Path to the `claude` binary if it is not on PATH. Default: claude (resolved via PATH).
# CLAUDE_BIN=claude

# Force a specific model. Default: Claude Code's own default model.
# CLAUDE_MODEL=claude-opus-4-8

# Model ids the /fast and /deep commands select (per-project model routing, P9).
# /fast -> FAST_MODEL (cheap + quick), /deep -> DEEP_MODEL (most capable); /auto clears
# the override back to CLAUDE_MODEL / the SDK default. Defaults to the current sensible ids.
# FAST_MODEL=claude-haiku-4-5
# DEEP_MODEL=claude-opus-4-8

# Max seconds to wait for one Claude turn before timing out. Positive integer. Default: 600.
# CLAUDE_TIMEOUT_SECONDS=600

# Approval-gate bypass. Default: false = the per-tool approval gate is ON (safe).
# Set true ONLY to opt into allow-all (--dangerously-skip-permissions): Claude then runs
# EVERY tool with NO approval prompt. This is a loud, explicit choice (warns at startup);
# prefer ENGINE_MODE=streaming + per-tool approval instead. Leave false unless you mean it.
# CLAUDE_SKIP_PERMISSIONS=false

# Engine mode: oneshot | streaming. Default: oneshot (today's behavior, no interactive prompts).
# streaming enables in-Telegram Allow/Deny tool approval, multi-project sessions, and
# concurrency (the recommended mode). The vars below it (ANSWER_BACKSTOP_SECONDS,
# MAX_CONCURRENT_RUNS, RENDER_CHAT_SEND_INTERVAL_SECONDS, STREAM_MESSAGE_TIMEOUT_SECONDS)
# are only consulted in streaming mode.
# ENGINE_MODE=oneshot

# /cd, /new, AND Claude's file/search tools are confined to these roots (comma- or
# os.pathsep-separated). A tool targeting a path outside them prompts for approval.
# Default: CLAUDE_WORKDIR (confinement ON). Set a narrow list. See ALLOW_ANY_PATH to disable.
# ALLOWED_ROOTS=/Users/you/dev

# Disable path confinement entirely (true = you take the wheel; any path is allowed).
# Default: false (confinement ON — the safe default).
# ALLOW_ANY_PATH=false

# Max turns that RUN at once across the whole process (streaming mode); extra turns QUEUE
# (FIFO per chat) and start when a slot frees — never refused. 0/unset -> default; negative
# fails loud. Default: 3.
# MAX_CONCURRENT_RUNS=3

# Min seconds between any two outbound sends/edits to ONE chat (streaming mode), so
# concurrent projects don't burst past Telegram's ~1 msg/s/chat ceiling. 0 disables the
# spacing; negative fails loud. Default: 1.0.
# RENDER_CHAT_SEND_INTERVAL_SECONDS=1.0

# Max seconds the streaming substrate waits for the next message from Claude before
# declaring it wedged (streaming mode). Must be GENEROUS — it also bounds how long an
# approved long-running tool (build/test/install) may run silently. Suspended while a
# decision prompt is open. Positive number; 0/negative fails loud. Default: 300.0.
# STREAM_MESSAGE_TIMEOUT_SECONDS=300.0

# Seconds to hold a pending Allow/Deny (ask/plan) prompt open before auto-denying +
# notifying (streaming mode). Positive integer. Default: 3600 (60 minutes).
# ANSWER_BACKSTOP_SECONDS=3600

# Max size (BYTES) of an inbound photo/screenshot the bot accepts and sends to Claude as
# an image (multimodal, streaming mode). A larger image is refused with a clean message.
# Positive integer; 0/negative fails loud. Default: 5242880 (5 MB).
# IMAGE_MAX_BYTES=5242880

# Max size (BYTES) of a file the bot accepts inbound (a non-image document saved,
# path-confined, into the active project) or uploads outbound (/get <path>). Both
# directions; streaming mode. A larger file is refused with a clean message. Positive
# integer; 0/negative fails loud. Default: 20971520 (20 MB).
# FILE_MAX_BYTES=20971520

# Voice transcription (PLUGGABLE, OFF by default). Set TRANSCRIBE_CMD to a command TEMPLATE
# and a voice note is downloaded, transcribed, echoed back, and run as a turn (streaming
# mode). UNSET/empty = voice is gracefully off: a voice note gets a clean "install a
# transcriber and set TRANSCRIBE_CMD" message (no crash). No transcriber is bundled.
#   Placeholders: {audio} = the input audio path (a temp file the bot controls);
#                 {out}   = an output basename (optional). If the template mentions {out},
#                           the transcript is read from <out>.txt (whisper.cpp's
#                           `-otxt -of {out}`); otherwise it is read from the command's stdout.
# The template is split with shlex and run via exec — NEVER a shell (injection-safe; the
# audio path is always a single argv token). NOTE: the bot passes the RAW downloaded audio
# (Telegram opus .ogg) as {audio} — your command must accept that, or convert it first.
# RECOMMENDED (local, free, private — audio never leaves your Mac): the bundled helper does
# the ffmpeg .ogg->16kHz-wav conversion + runs whisper.cpp for you. One-time setup:
#   brew install ffmpeg whisper-cpp
#   mkdir -p ~/.cache/whisper-models && curl -fsSL -o ~/.cache/whisper-models/ggml-base.en.bin \
#     https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.en.bin
# then (use the ABSOLUTE path to this repo's deploy/ script):
# TRANSCRIBE_CMD=bash /Users/you/dev/claude-telegram-bot/deploy/transcribe-whisper.sh {audio} {out}
# TRANSCRIBE_CMD=my-stt --file {audio}          # or any STT CLI that prints the transcript to stdout

# Max seconds the TRANSCRIBE_CMD subprocess may run before it's killed + a clean timeout
# error is returned (streaming mode; only when TRANSCRIBE_CMD is set). Positive number;
# 0/negative fails loud. Default: 120.0.
# TRANSCRIBE_TIMEOUT_SECONDS=120.0

# Persist per-chat session id + working dir across bot restarts. Default: none (in-memory only).
# CLAUDE_STATE_FILE=.claude_tg_sessions.json

# Durable, BODY-FREE audit trail (P13): an append-only JSONL log of security-relevant
# decisions — tool allow/deny, plan approve/reject, /attach·/switch·/watch, /yolo — written
# atomically with 0600 perms. Review the recent tail on your phone with /audit. It records
# ONLY tool names, body-free input summaries (lengths, not contents), verdicts, redacted
# session tags, and timestamps — NEVER file contents, command output, prompts, or secrets.
# Default ON but non-breaking: when CLAUDE_STATE_FILE is set the log defaults to
# <state_file>.audit.jsonl (next to the store). With no state file it is OFF unless you set
# a path here. Set AUDIT_LOG_FILE to a path to override, or to off/none/empty to DISABLE.
# AUDIT_LOG_FILE=.claude_tg_sessions.json.audit.jsonl

# Size (BYTES) the audit log may reach before a 1-keep rotation to <file>.1 (so disk is
# bounded to ~2x this). Positive integer; 0/negative fails loud. Default: 5242880 (5 MB).
# AUDIT_LOG_MAX_BYTES=5242880

# Bash command policy (P13) — a conservative guardrail on the ONE unconfined tool (Bash),
# layered on top of the approval gate (streaming mode). A matched DANGEROUS command (rm -rf
# of / ~ $HOME, curl|sh / wget|sh, git push --force, mkfs, dd of=/dev/…, fork bomb,
# chmod -R 777, reads of ~/.ssh/id_*, .aws/credentials, .env) is handled per mode:
#   flag (default): ESCALATE the prompt — show ⚠️ + the matched pattern, DROP the
#                   "Allow for session" button, and RE-PROMPT even if Bash is already
#                   session-granted or /yolo is on (so a dangerous command always re-confirms
#                   — this closes the documented C2 residual). NON-BREAKING: it only adds
#                   friction to commands that already prompt; it never auto-runs anything new.
#   deny:           AUTO-DENY a matched command outright (a hard wall — overrides /yolo too).
#   off:            disable the policy — byte-for-byte the pre-P13 gate (Bash gates by name).
# It is a HEURISTIC pattern guardrail (matched on the raw command), NOT a sandbox: it raises
# the floor against obvious/accidental destruction, not a determined adversary. Default: flag.
# BASH_POLICY_MODE=flag

# Extra Bash-policy denylist patterns (regex), ADDITIVE to the built-ins (the built-ins can't
# be removed via config — that needs a code change). Newline- or semicolon-separated (commas
# are NOT separators — a regex may contain them). A pattern that won't compile FAILS LOUD at
# startup (names the bad pattern) — never silently dropped, since a lost safety rule would
# fail OPEN. Empty by default. Example (one regex): BASH_POLICY_EXTRA_PATTERNS=\bshutdown\b
# BASH_POLICY_EXTRA_PATTERNS=
